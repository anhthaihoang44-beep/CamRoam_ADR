<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>RoamCam</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>roamcam</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Permission strings for RoamCam features -->
	<key>NSCameraUsageDescription</key>
	<string>RoamCam requires access to your camera to take GPS-stamped photos with real-time coordinate overlays.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>RoamCam requires microphone access when recording exploration video clips.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RoamCam requires your location to display live webcams near you, calibrate the digital compass, and record GPS coordinates on photos.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>RoamCam uses your location to discover nearby webcams and stamp your landmark passport.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>RoamCam needs access to your photo library to save your watermarked GPS exploration photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>RoamCam saves your watermarked GPS exploration photos to your photo library.</string>
	<key>NSMotionUsageDescription</key>
	<string>RoamCam requires access to motion and compass sensors to provide the real-time digital compass tool.</string>

	<!-- Allow opening external maps and webcams -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>maps</string>
		<string>googlemaps</string>
		<string>comgooglemaps</string>
	</array>
</dict>
</plist>

